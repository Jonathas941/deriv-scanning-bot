# ---------------------------------------------------------------------------
# Deriv API credentials
# ---------------------------------------------------------------------------
# Register an app at https://app.deriv.com/account/api-token to get these.
# NEVER commit real values. Set them in Railway's variable editor.
DERIV_APP_ID=1089
DERIV_ACCESS_TOKEN=
# Optional: restrict the bot to one specific loginid (e.g. VRTC1234567 / CR1234567).
# If set and the authorized account does not match, the bot refuses to start.
DERIV_ACCOUNT_ID=
# "demo" or "real". The bot cross-checks this against the account Deriv reports
# and refuses to start on a mismatch.
DERIV_ACCOUNT_TYPE=demo

# ---------------------------------------------------------------------------
# THE MASTER SAFETY SWITCH
# ---------------------------------------------------------------------------
# false = scan, score and log signals but never send a buy order (dry run).
# true  = actually place trades with real money on a real account.
# Defaults to false. Leave it false until you have watched the signals.
ENABLE_REAL_TRADING=false

# ---------------------------------------------------------------------------
# Signal thresholds
# ---------------------------------------------------------------------------
# Minimum confluence score (0-100) required before a trade is considered.
MIN_SIGNAL_SCORE=70

# ---------------------------------------------------------------------------
# Risk limits — enforced as hard circuit breakers, not suggestions.
# When any of these trips, the bot halts trading until manually resumed.
# ---------------------------------------------------------------------------
RISK_PER_TRADE_PERCENT=1
MAX_TRADES_PER_DAY=20
MAX_OPEN_TRADES=2
MAX_CONSECUTIVE_LOSSES=3
DAILY_LOSS_LIMIT_PERCENT=5
MAX_DRAWDOWN_PERCENT=10

# ---------------------------------------------------------------------------
# Markets
# ---------------------------------------------------------------------------
# Comma-separated Deriv symbols. Leave blank to auto-discover from
# SCAN_MARKETS below using the active_symbols API.
SCAN_SYMBOLS=
# Which market groups to auto-discover: synthetic_index, forex, or both
SCAN_MARKETS=synthetic_index,forex
# Max symbols to scan concurrently (protects against rate limits)
MAX_SCAN_SYMBOLS=12

# ---------------------------------------------------------------------------
# Strategy tuning
# ---------------------------------------------------------------------------
CANDLE_GRANULARITY=60
CANDLE_COUNT=200
SCAN_INTERVAL_SECONDS=60
CONTRACT_DURATION=5
CONTRACT_DURATION_UNIT=m
EMA_FAST=9
EMA_SLOW=21
EMA_TREND=50
RSI_PERIOD=14
ATR_PERIOD=14

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080
NODE_ENV=production
# Optional bearer token protecting /control/* mutating endpoints.
# If unset, control endpoints are disabled entirely (safe default).
ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# Webhook (optional) — signals and trades are POSTed here as JSON
# ---------------------------------------------------------------------------
WEBHOOK_URL=
WEBHOOK_EVENTS=signal,trade,halt
